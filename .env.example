# SQLite file. Prisma resolves relative paths from prisma/schema.prisma,
# so file:./data/app.db is stored at prisma/data/app.db.
DATABASE_URL="file:./data/app.db"

# Password for /admin (sent as the x-admin-secret header). Required in production.
ADMIN_SECRET="change-me-to-a-long-random-string"

# Header holding the real client IP for the registration rate limit.
# Behind Cloudflare Tunnel use cf-connecting-ip. Leave empty to use the
# last x-forwarded-for hop (set by the Next.js server itself).
TRUST_PROXY_HEADER=""
