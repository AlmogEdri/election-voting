generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  // Relative SQLite paths resolve from this directory: file:./data/app.db -> prisma/data/app.db
  url      = env("DATABASE_URL")
}

model User {
  id          String   @id @default(cuid())
  name        String
  nameNorm    String   @unique @map("name_norm")
  // SHA-256 of the device token; the raw token only lives in the browser.
  deviceToken String   @unique @map("device_token")
  createdAt   DateTime @default(now()) @map("created_at")
  vote        Vote?

  @@map("users")
}

model Party {
  id           String        @id
  name         String
  letters      String
  leader       String
  color        String
  bloc         String
  sort         Int
  active       Boolean       @default(true)
  withdrawn    Boolean       @default(false)
  defaultSeats Int           @default(0) @map("default_seats")
  pmCandidates PmCandidate[]

  @@map("parties")
}

model PmCandidate {
  id      String  @id
  name    String
  partyId String? @map("party_id")
  party   Party?  @relation(fields: [partyId], references: [id])
  sort    Int
  active  Boolean @default(true)
  votes   Vote[]

  @@map("pm_candidates")
}

model Vote {
  id            String      @id @default(cuid())
  userId        String      @unique @map("user_id")
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  // JSON object {partyId: seats}
  seats         String
  pmCandidateId String      @map("pm_candidate_id")
  pmCandidate   PmCandidate @relation(fields: [pmCandidateId], references: [id])
  updatedAt     DateTime    @updatedAt @map("updated_at")

  @@map("votes")
}

model Setting {
  key   String @id
  // JSON value
  value String

  @@map("settings")
}
